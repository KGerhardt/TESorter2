__pycache__/
*.pyc
*.fxi
*.db
!tesorter2/database/*.similarity_graph.db
*.tsv
# ...except the clade harmonization tables: these are source, not data. They
# ship in the wheel via package-data and drive the multi-database vote.
!tesorter2/database/clade_harmonization.tsv
!tesorter2/database/clade_scope.tsv
*.faa
*.fasta
*.fa

# BATH-format HMMs, generated by bathconvert on first use and cached beside
# the source HMM. Tens of MB per database and fully derived.
*.bath.hmm

# HMM index files (generated by hmmpress/pyhmmer)
*.h3f
*.h3i
*.h3m
*.h3p

# TEsorter reference and modifications
TEsorter/
modified_TEsorter-master/

# Baseline benchmarks (large temp files)
baseline/

# Old prototype
ksort.py

# Test/temp files
tmp*/
*.tmp

# BATH fork scratch/verification outputs
_verify/
_genome_test/
_full510/

# Regression suite: track the scripts, never the 2.6 GB of venvs, the nested
# pre-refactor checkout in orig/, the input FASTAs or the regenerated outputs.
_regression/*
!_regression/*.sbatch
!_regression/*.py

# Python build artifacts (sdist/wheel/metadata)
dist/
build/
*.egg-info/

# Database manifests ship with the package (pyproject packages database/*),
# so they are exempt from the blanket *.tsv rule above.
!tesorter2/database/*.tsv
